PORT=5000

# Conexión local con PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=tienda_tecnologia

# Conexión a Base de Datos Remota (Supabase / Neon / Vercel Postgres)
# Si defines DATABASE_URL, el backend la usará automáticamente con SSL activado.
# En Supabase: Settings -> Database -> Connection string -> URI (Modo Transaction o Session pooler, puerto 6543 o 5432)
#DATABASE_URL=postgresql://postgres:[TU_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
#DATABASE_SSL=true

# Configuración opcional de correo SMTP para envío de enlaces y códigos OTP de verificación
# Si no se define, el servidor usa cuenta de prueba Ethereal y devuelve el enlace / código en logs y respuesta
#PUBLIC_URL=https://tu-app-en-vercel.app
#SMTP_HOST=smtp.gmail.com
#SMTP_PORT=587
#SMTP_SECURE=false
#SMTP_USER=tu_correo@gmail.com
#SMTP_PASS=tu_app_password
#SMTP_FROM="NexPOS Suite <no-reply@nexpos.local>"
